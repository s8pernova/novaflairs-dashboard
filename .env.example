# Docker Compose orchestration
TZ=America/New_York
PUID=1000
PGID=1000
NODE_RED_DB_CA_CERT_PATH=/etc/novaflairs/supabase-ca.pem

# UI build args. These are browser-visible values, not server secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
