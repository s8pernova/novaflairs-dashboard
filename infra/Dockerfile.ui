#  Novaflairs Dashboard – Frontend Dockerfile

# ──────────────────────────────────────────────────────────────────────────────
# Stage 1 · Builder  (Node)
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy manifests first so Docker can cache the install layer.
COPY ui/package.json ui/package-lock.json ./

# Install all dependencies (including devDependencies required by Vite/tsc).
RUN npm ci --prefer-offline

# Copy the rest of the UI source.
COPY ui/ ./

# TypeScript compile + Vite bundle → output lands in /app/dist
RUN npm run build

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2 · Runtime  (Nginx)
# ──────────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

LABEL maintainer="novaflairs" \
    description="Novaflairs Dashboard - React frontend served by Nginx"

# Remove the default Nginx welcome page.
RUN rm -rf /usr/share/nginx/html/*

# Copy the compiled frontend from the builder stage.
COPY --from=builder /app/dist /usr/share/nginx/html

# Drop in our custom Nginx config (SPA routing + compression + security headers).
COPY infra/nginx.ui.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Nginx runs in the foreground by default in the official image.
CMD ["nginx", "-g", "daemon off;"]
