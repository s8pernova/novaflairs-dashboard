# Node-RED editor/runtime
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD='replace-with-a-bcrypt-hash'
NODE_RED_CREDENTIAL_SECRET=replace-with-a-long-random-secret

# Database connection used by the Node-RED PostgreSQL flow
DB_HOST=db.example.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD='replace-with-database-password'
DB_SSL_REJECT_UNAUTHORIZED=true
